# =====================================================
# PRODUÇÃO — Agência Funerária Kuphassana
# Preencher com os valores reais antes de fazer deploy
# =====================================================

# Base de dados PostgreSQL (produção)
DB_HOST=SEU_HOST_BD
DB_PORT=5432
DB_NAME=kuphassana_prod
DB_USER=SEU_UTILIZADOR_BD
DB_PASSWORD=SUA_SENHA_SEGURA

# Servidor
PORT=3000
NODE_ENV=production

# JWT — usar uma chave longa e aleatória em produção
JWT_SECRET=GERAR_CHAVE_ALEATORIA_AQUI_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=7d

# URL do frontend (para CORS)
FRONTEND_URL=https://kuphassana.co.mz

# Email de notificação (opcional)
ADMIN_EMAIL=admin@kuphassana.co.mz

# Twilio WhatsApp (opcional — notificações automáticas)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
